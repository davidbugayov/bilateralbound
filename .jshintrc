{
  "esversion": 11,
  "node": true,
  "browser": false,
  "strict": false,
  "asi": true,
  "boss": true,
  "curly": false,
  "eqeqeq": false,
  "eqnull": true,
  "evil": false,
  "expr": true,
  "forin": true,
  "immed": true,
  "latedef": false,
  "loopfunc": true,
  "noarg": true,
  "regexp": true,
  "regexdash": true,
  "scripturl": false,
  "shadow": true,
  "supernew": true,
  "undef": true,
  "unused": false,
  "multistr": true,
  "lastsemic": true,
  "laxbreak": true,
  "laxcomma": true,
  "devel": true,
  "-W033": false,
  "-W097": false,
  "globals": {
    "module": true,
    "exports": true,
    "require": true,
    "process": true,
    "Buffer": true,
    "__dirname": true,
    "__filename": true,
    "setImmediate": true,
    "clearImmediate": true,
    "setInterval": true,
    "clearInterval": true,
    "setTimeout": true,
    "clearTimeout": true,
    "console": true,
    "global": true,
    "globalThis": true,
    "performance": true,
    "CustomEvent": true,
    "Path2D": true,
    "requestAnimationFrame": true,
    "cancelAnimationFrame": true
  }
}
