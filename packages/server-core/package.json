{
  "name": "@emdr/server-core",
  "version": "1.0.0",
  "description": "EMDR therapy server core components",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "echo 'No tests specified'",
    "lint": "eslint server/**/*.js --ext .js --config ../../config/eslint.config.js",
    "lint:fix": "eslint server/**/*.js --ext .js --fix --config ../../config/eslint.config.js",
    "format": "prettier --write 'server/**/*.js' --config ../../config/.prettierrc",
    "format:check": "prettier --check 'server/**/*.js' --config ../../config/.prettierrc"
  },
  "keywords": [
    "emdr",
    "therapy",
    "server",
    "websocket"
  ],
  "author": "Bugaev David",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "nodemon": "^3.1.10"
  }
}
