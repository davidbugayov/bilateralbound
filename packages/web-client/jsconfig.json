{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2015", "DOM"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": "./public/js",
    "paths": {
      "@client/*": ["./*"]
    }
  },
  "include": [
    "public/js/**/*",
    "public/**/*",
    "src/**/*",
    "**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
