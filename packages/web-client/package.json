{
  "name": "@emdr/web-client",
  "version": "2.39.746",
  "description": "EMDR therapy web client",
  "main": "public/index.html",
  "type": "commonjs",
  "scripts": {
    "start": "webpack --mode=development",
    "build": "NODE_ENV=production webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --watch --mode development",
    "serve": "npx serve -s public",
    "lint:sonarqube": "node sonar-scanner.js",
    "minify:css": "for f in public/css/*.css; do [ -f \"$f\" ] && cleancss -O1 -o \"$f\" \"$f\"; done"
  },
  "keywords": [
    "emdr",
    "therapy",
    "web",
    "client"
  ],
  "author": "Bugaev David",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@fontsource-variable/inter": "^5.2.8",
    "babel-loader": "^9.2.1",
    "clean-css-cli": "^5.6.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^9.39.2",
    "eslint-formatter-sonarqube": "^1.0.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.6",
    "sonarqube-scanner": "^4.3.4",
    "style-loader": "^3.3.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  }
}
