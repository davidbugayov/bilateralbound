{
  "name": "@emdr/web-client",
  "version": "2.39.6",
  "description": "EMDR therapy web client",
  "main": "public/index.html",
  "type": "commonjs",
  "scripts": {
    "start": "webpack --mode=development",
    "build": "webpack --mode=production",
    "serve": "npx serve -s public",
    "lint": "eslint public/js --ext .js",
    "lint:fix": "eslint public/js --ext .js --fix",
    "lint:report": "eslint public/js --ext .js --format json > ../reports/eslint-web-client.json 2>&1 || true",
    "lint:sonarqube": "node sonar-scanner.js"
  },
  "keywords": [
    "emdr",
    "therapy",
    "web",
    "client"
  ],
  "author": "Bugaev David",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^9.39.2",
    "eslint-formatter-sonarqube": "^1.0.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.6",
    "sonarqube-scanner": "^4.3.4",
    "style-loader": "^3.3.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "jshint": "^2.13.6"
  }
}
