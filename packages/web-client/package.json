{
  "name": "@emdr/web-client",
  "version": "1.0.0",
  "description": "EMDR therapy web client",
  "main": "public/index.html",
  "type": "commonjs",
  "scripts": {
    "start": "webpack --mode=development",
    "build": "webpack --mode=production",
    "serve": "npx serve -s public",
    "lint": "eslint public/js/**/*.js --ext .js --config ../../config/eslint.config.js",
    "lint:fix": "eslint public/js/**/*.js --ext .js --fix --config ../../config/eslint.config.js",
    "format": "prettier --write 'public/js/**/*.js' --config ../../config/.prettierrc",
    "format:check": "prettier --check 'public/js/**/*.js' --config ../../config/.prettierrc"
  },
  "keywords": [
    "emdr",
    "therapy",
    "web",
    "client"
  ],
  "author": "Bugaev David",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
