<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <defs>
    <linearGradient id="eyeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#60a5fa"/>
      <stop offset="100%" style="stop-color:#3b82f6"/>
    </linearGradient>
  </defs>

  <!-- Внешний контур глаза -->
  <ellipse cx="16" cy="16" rx="14" ry="8" fill="none" stroke="#1f2937" stroke-width="2"/>

  <!-- Радужка -->
  <circle cx="16" cy="16" r="8" fill="url(#eyeGradient)"/>

  <!-- Зрачок -->
  <circle cx="16" cy="16" r="4" fill="#1f2937"/>

  <!-- Блик -->
  <circle cx="20" cy="12" r="2" fill="#ffffff" opacity="0.8"/>
  <circle cx="21" cy="11" r="1" fill="#ffffff" opacity="0.6"/>

  <!-- Ресницы -->
  <line x1="4" y1="12" x2="6" y2="10" stroke="#1f2937" stroke-width="1"/>
  <line x1="28" y1="12" x2="26" y2="10" stroke="#1f2937" stroke-width="1"/>
</svg>

