name: Deploy to Production

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v3

    - name: Setup Node.js
      uses: actions/setup-node@v3
      with:
        node-version: '18'
        cache: 'npm'

    - name: Install dependencies
      run: npm ci

    - name: Build application
      run: npm run build --if-present

    - name: Deploy to server
      env:
        SERVER: "213.139.229.44"
        USER: "root"
        PASSWORD: ${{ secrets.VPS_PASSWORD }}
      run: |
        echo "🚀 Деплой на сервер $SERVER"

        # Устанавливаем sshpass для аутентификации
        sudo apt-get update
        sudo apt-get install -y sshpass

        # Создаем директорию на сервере
        sshpass -p "$PASSWORD" ssh -o StrictHostKeyChecking=no $USER@$SERVER "mkdir -p /var/www/bilateralbound"

        # Копируем файлы проекта
        sshpass -p "$PASSWORD" scp -o StrictHostKeyChecking=no -r ./* $USER@$SERVER:/var/www/bilateralbound/

        # Устанавливаем зависимости на сервере
        sshpass -p "$PASSWORD" ssh -o StrictHostKeyChecking=no $USER@$SERVER "cd /var/www/bilateralbound && npm install --production"

        # Перезапускаем сервис
        sshpass -p "$PASSWORD" ssh -o StrictHostKeyChecking=no $USER@$SERVER "systemctl restart bilateralbound.service || systemctl start bilateralbound.service"

        echo "✅ Деплой завершен успешно"

    - name: Verify deployment
      env:
        SERVER: "213.139.229.44"
        USER: "root"
        PASSWORD: ${{ secrets.VPS_PASSWORD }}
      run: |
        echo "🔍 Проверка деплоя..."

        # Проверяем статус сервиса
        sshpass -p "$PASSWORD" ssh -o StrictHostKeyChecking=no $USER@$SERVER "systemctl status bilateralbound.service --no-pager"

        # Проверяем приложение
        sleep 5
        curl -f https://bilateralbound.onrender.com/api/status || echo "⚠️ Приложение недоступно"

        echo "✅ Проверка завершена"
