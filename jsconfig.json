{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2015", "DOM"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["packages/server-core/server/*"],
      "@client/*": ["packages/web-client/public/js/*"]
    }
  },
  "include": [
    "packages/**/*",
    "packages/web-client/public/js/**/*",
    "packages/web-client/src/**/*",
    "packages/*/public/**/*",
    "scripts/**/*",
    "**/*.js"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "**/node_modules",
    "**/*.min.js",
    "packages/**/dist",
    "packages/**/build"
  ]
}
