{
  "name": "bilateralbound",
  "version": "2.42.0",
  "description": "A scalable real-time multiplayer game built with SOLID principles",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "webpack --mode=production",
    "test": "npm run test:server && npm run test:automated",
    "test:server": "node -c server/index.js && echo '✅ Server syntax OK'",
    "test:automated": "node test/automated-tests.js",
    "test:quick": "node test/automated-tests.js",
    "lint": "eslint server/index.js server/**/*.js public/js/*.js --ext .js",
    "lint:fix": "eslint server/index.js server/**/*.js public/js/*.js --ext .js --fix",
    "format": "prettier --write \"server/**/*.js\" \"public/js/*.js\" \"public/*.html\"",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "version": "node version-manager.js",
    "postversion": "git add package.json VERSION.md && git commit -m \"🔖 Release v$(node -e \"console.log(require('./package.json').version)\")\" && git tag v$(node -e \"console.log(require('./package.json').version)\")"
  },
  "keywords": [
    "game",
    "multiplayer",
    "http-only",
    "solid",
    "scalable"
  ],
  "author": "BilateralBound Team",
  "license": "ISC",
  "type": "commonjs",
  "homepage": ".",
  "render": {
    "type": "web",
    "buildCommand": "npm install",
    "startCommand": "npm start"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "uuid": "^9.0.1",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "html-loader": "^5.1.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.2.5",
    "puppeteer": "^23.11.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}