[Unit]
Description=BilateralBound EMDR - Auto Deploy
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/bilateralbound-auto-current
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/bilateralbound-auto-current /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bilateralbound-auto

Environment=NODE_ENV=production
Environment=PORT=3003

[Install]
WantedBy=multi-user.target
